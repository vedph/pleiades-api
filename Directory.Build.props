<Project>
  <PropertyGroup>
    <!-- the version of all the projects and of the Pleiades packages they
    reference in Release (see Directory.Packages.props): bump it only here -->
    <PleiadesVersion>3.0.2</PleiadesVersion>
    <Version>$(PleiadesVersion)</Version>
    <FileVersion>$(PleiadesVersion)</FileVersion>
    <AssemblyVersion>$(PleiadesVersion)</AssemblyVersion>
  </PropertyGroup>
</Project>
