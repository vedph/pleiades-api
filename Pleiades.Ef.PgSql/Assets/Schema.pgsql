-- Pleiades Embix index tables (PostgreSQL 15+). This script is idempotent.
-- Secondary indexes and constraints are in Indexes.pgsql, so that they
-- can be dropped before a bulk load and recreated after it.

-- trigram indexes for substring/suffix/wildcard/regex/similarity searches
CREATE EXTENSION IF NOT EXISTS pg_trgm;

-- eix_token: IDs are assigned by the indexer; the identity is BY DEFAULT
-- so that explicit IDs are accepted, and its sequence is synchronized
-- after each load.
CREATE TABLE IF NOT EXISTS eix_token (
	id integer GENERATED BY DEFAULT AS IDENTITY,
	value varchar(100) NOT NULL,
	"language" varchar(5) NULL,
	CONSTRAINT eix_token_pk PRIMARY KEY (id)
);

-- eix_occurrence: target_id is a place ID; field is a 5-letters code
-- (plttl, pldsc, pldtl, lcttl, nmrmz, nmatt, nmdsc); rank and years are
-- metadata supplied by the indexer.
CREATE TABLE IF NOT EXISTS eix_occurrence (
	id integer GENERATED BY DEFAULT AS IDENTITY,
	token_id integer NOT NULL,
	field varchar(5) NOT NULL,
	target_id varchar(20) NOT NULL,
	"rank" integer NULL,
	year_min smallint NULL,
	year_max smallint NULL,
	CONSTRAINT eix_occurrence_pk PRIMARY KEY (id)
);

-- upgrade legacy schemas, where field was char(5): char comparisons with
-- text parameters cannot use the indexes on field
DO $$
BEGIN
	IF EXISTS (
		SELECT 1 FROM information_schema.columns
		WHERE table_name = 'eix_occurrence' AND column_name = 'field'
		AND data_type = 'character'
	) THEN
		ALTER TABLE eix_occurrence ALTER COLUMN field TYPE varchar(5);
	END IF;
END $$;
